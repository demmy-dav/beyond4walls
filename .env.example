# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel > Project > Settings > Environment Variables, ticking Production
# (not only Preview). Env changes only apply to NEW deployments: redeploy after.
# Never commit real values.

# --- Membership form email (api/membership.js) ---
# Resend API key (https://resend.com/api-keys), "Sending access" is enough.
# The beyond4wallsed.org domain must be verified in Resend for this key's account.
RESEND_API_KEY=

# Inbox that receives every membership application (production: the hello@ inbox)
MEMBERSHIP_TO_EMAIL=

# --- Membership form storage (api/membership.js) ---
# Supabase (Project Settings > API). Run supabase/migrations/002_membership_applications.sql
# first. The service role key bypasses row level security: server only, mark it sensitive.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
