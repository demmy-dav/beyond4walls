# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Resend API key (https://resend.com/api-keys), "Sending access" is enough
RESEND_API_KEY=

# Inbox that receives every membership application (production: the hello@ inbox)
MEMBERSHIP_TO_EMAIL=

# Supabase (Project Settings > API). The anon key is public by design; the
# service role key bypasses row level security: server only, mark it sensitive.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site address used in applicant emails (defaults to https://www.beyond4wallsed.org)
SITE_URL=
